# Copie para .env local (não versione valores reais).
AGROCALC_SECRET_KEY=gere-uma-chave-aleatoria-longa
AGROCALC_ADMIN_EMAIL=admin@agrocalc.local
AGROCALC_ADMIN_PASSWORD=defina-uma-senha-forte
# Para PostgreSQL, configure a URL da conta agrocalc_app após executar database/postgresql_setup.sql.
# AGROCALC_DATABASE_URL=postgresql://agrocalc_app:SENHA@localhost:5432/agrocalc
# Para HTTPS em produção:
# FLASK_HTTPS_ONLY=1
